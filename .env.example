# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public"

# API (Nest.js)
API_PORT=4000
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# --- Только для production (Render), локально не нужны ---
# NODE_ENV=production
# CORS_ORIGINS=https://allmaz.shop,https://www.allmaz.shop   # по умолчанию = FRONTEND_URL
# API_PUBLIC_URL=https://api.allmaz.shop                     # откуда браузер берёт загруженные картинки
# COOKIE_DOMAIN=.allmaz.shop                                 # общий родительский домен сайта и API
# STORAGE_API_KEY=sk_rd_...                                  # внешнее хранилище RelaxDev: загрузки товаров уходят в CDN (без ключа — на локальный диск)
# UPLOADS_DIR=uploads                                        # локальная папка загрузок (по умолчанию ./uploads)
# SHOP_TIMEZONE=Europe/Moscow                                 # часовой пояс магазина: границы суток в аналитике продаж (по умолчанию Москва)
# UNPAID_ORDER_TTL_MINUTES=120                               # через сколько минут неоплаченный заказ картой отменяется автоматически (по умолчанию 120)
# UNPAID_ORDER_JOB=off                                       # отключить фоновую автоотмену
# THROTTLE_LIMIT=1000                                        # общий лимит запросов/мин на IP (SSR ходит с одного IP)

# SMTP — используем Mailtrap (https://mailtrap.io/)
#
# Для ТЕСТИРОВАНИЯ (письма не уходят реальным адресатам, только в твой
# sandbox-инбокс на mailtrap.io — удобно для разработки):
#   1. Зайди в Mailtrap → Email Testing → создай/открой инбокс
#   2. Вкладка SMTP Settings → выбери "Nodemailer" — там будут готовые host/port/user/pass
#   Обычно это:
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=2525
#   SMTP_USER=<из панели Mailtrap>
#   SMTP_PASS=<из панели Mailtrap>
#
# Для РЕАЛЬНОЙ отправки (на настоящие email пользователей) — нужен
# подтверждённый домен отправителя: Mailtrap → Sending → Domains, там
# будут другие host/user/pass (обычно live.smtp.mailtrap.io) и SMTP_FROM
# должен быть адресом на этом подтверждённом домене.
#
# Если оставить эти поля пустыми — письма просто выводятся в консоль API
# (удобно для быстрой локальной разработки без Mailtrap вообще)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@ecommerce.local

# ЮKassa (оплата картой онлайн)
#
# Если оставить пустыми — используются ПУБЛИЧНЫЕ тестовые креды самой ЮKassa
# для самостоятельного тестирования (см. их GitHub-документацию), платежи
# при этом полностью тестовые, реальных денег нет. Тестовая карта для оплаты:
# 5555555555554444, срок 12/20, CVC 000.
#
# Когда заведёшь свой аккаунт (https://yookassa.ru/) — впиши сюда свои
# shopId и secretKey из личного кабинета (Интеграция → Ключи API). Там же
# отдельно будут тестовые (test_...) и боевые (live_...) ключи.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- SEO (проект web; читаются на сервере при каждом запросе) ---
# API_URL=https://api.allmaz.shop  # адрес API для сайта; читается при запуске, пересборка не нужна
# SITE_URL=https://allmaz.shop      # публичный адрес сайта: canonical, sitemap.xml, robots.txt
# SITE_NAME=Allmaz.Shop             # название магазина в заголовках и разметке
# SEO_NOINDEX=true                  # закрыть сайт от индексации (стенд / до запуска)

# --- Автотесты ---
# Отдельная БД для тестов с «test» в имени (тесты ОЧИЩАЮТ её таблицы). Без неё тесты с БД пропускаются. См. docs/TESTING.md
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce_test
