# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public"

# API (Nest.js)
API_PORT=4000
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# SMTP (для писем восстановления пароля). Если не заполнить —
# ссылка для сброса пароля просто выведется в консоль API (удобно для локальной разработки)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@ecommerce.local

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000
