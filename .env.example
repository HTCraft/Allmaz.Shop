# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public"

# API (Nest.js)
API_PORT=4000
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# SMTP — используем Mailtrap (https://mailtrap.io/)
#
# Для ТЕСТИРОВАНИЯ (письма не уходят реальным адресатам, только в твой
# sandbox-инбокс на mailtrap.io — удобно для разработки):
#   1. Зайди в Mailtrap → Email Testing → создай/открой инбокс
#   2. Вкладка SMTP Settings → выбери "Nodemailer" — там будут готовые host/port/user/pass
#   Обычно это:
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=2525
#   SMTP_USER=<из панели Mailtrap>
#   SMTP_PASS=<из панели Mailtrap>
#
# Для РЕАЛЬНОЙ отправки (на настоящие email пользователей) — нужен
# подтверждённый домен отправителя: Mailtrap → Sending → Domains, там
# будут другие host/user/pass (обычно live.smtp.mailtrap.io) и SMTP_FROM
# должен быть адресом на этом подтверждённом домене.
#
# Если оставить эти поля пустыми — письма просто выводятся в консоль API
# (удобно для быстрой локальной разработки без Mailtrap вообще)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@ecommerce.local

# ЮKassa (оплата картой онлайн)
#
# Если оставить пустыми — используются ПУБЛИЧНЫЕ тестовые креды самой ЮKassa
# для самостоятельного тестирования (см. их GitHub-документацию), платежи
# при этом полностью тестовые, реальных денег нет. Тестовая карта для оплаты:
# 5555555555554444, срок 12/20, CVC 000.
#
# Когда заведёшь свой аккаунт (https://yookassa.ru/) — впиши сюда свои
# shopId и secretKey из личного кабинета (Интеграция → Ключи API). Там же
# отдельно будут тестовые (test_...) и боевые (live_...) ключи.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000
