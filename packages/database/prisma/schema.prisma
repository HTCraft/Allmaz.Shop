generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Заглушки базовых сущностей — расширим по ходу проектирования домена

enum Role {
  USER
  ADMIN
}

model User {
  id                       String                     @id @default(cuid())
  email                    String                     @unique
  password                 String
  name                     String?
  role                     Role                       @default(USER)
  isVerified               Boolean                    @default(false)
  orders                   Order[]
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  cart                     Cart?
  favorites                Favorite[]
  reviews                  Review[]
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  code      String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id             String          @id @default(cuid())
  title          String
  slug           String          @unique
  description    String?
  priceCents     Int
  sku            String          @unique
  stock          Int             @default(0)
  category       Category?       @relation(fields: [categoryId], references: [id])
  categoryId     String?
  media          ProductMedia[]
  orderItems     OrderItem[]
  cartItems      CartItem[]
  favorites      Favorite[]
  carouselSlides CarouselSlide[]
  reviews        Review[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

enum MediaType {
  IMAGE
  VIDEO
}

/**
 * Медиафайл товара — изображение или видео. Поддерживает два источника:
 * 1) внешняя ссылка (заполняется через текстовое поле в форме, filename пуст);
 * 2) загруженный файл — физически лежит на диске сервера в apps/api/uploads/,
 *    url при этом хранит путь вида "/uploads/xxx.jpg", отдаётся статикой Express.
 * Файлы никогда не хранятся в самой БД — только путь/ссылка на них.
 */
model ProductMedia {
  id        String    @id @default(cuid())
  type      MediaType @default(IMAGE)
  url       String // внешняя ссылка ИЛИ путь /uploads/... к файлу на диске
  filename  String? // исходное имя загруженного файла; пусто для внешних ссылок
  alt       String?
  position  Int       @default(0)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime  @default(now())
}

model Order {
  id              String        @id @default(cuid())
  user            User          @relation(fields: [userId], references: [id])
  userId          String
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod @default(COD)
  paymentId       String? // id платежа в ЮKassa (заполняется для paymentMethod = CARD)
  shippingAddress String
  phone           String
  comment         String?
  totalCents      Int // итоговая сумма К ОПЛАТЕ (уже с учётом скидки)
  discountCents   Int           @default(0) // сумма скидки по промокоду
  promoCode       PromoCode?    @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  promoCodeId     String?
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum PaymentMethod {
  COD // оплата при получении
  CARD // онлайн-оплата картой через ЮKassa
}

model OrderItem {
  id           String  @id @default(cuid())
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  product      Product @relation(fields: [productId], references: [id])
  productId    String
  productTitle String // снимок названия на момент заказа — переживает удаление товара
  productSku   String // снимок артикула на момент заказа
  quantity     Int     @default(1)
  priceCents   Int // снимок цены за единицу на момент заказа
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model Cart {
  id        String     @id @default(cuid())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String     @unique
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}

model Favorite {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model CarouselSlide {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId])
}

/** Единственная запись (id всегда "singleton") с глобальными настройками карусели на главной */
model CarouselSettings {
  id             String   @id @default("singleton")
  autoplay       Boolean  @default(true)
  intervalMs     Int      @default(5000)
  showIndicators Boolean  @default(true)
  showControls   Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

enum DiscountType {
  PERCENT // value = процент (1–100)
  FIXED // value = сумма в копейках
}

model PromoCode {
  id            String       @id @default(cuid())
  code          String       @unique // хранится в верхнем регистре
  discountType  DiscountType
  value         Int
  isActive      Boolean      @default(true)
  maxUses       Int? // null — без лимита
  usedCount     Int          @default(0)
  minOrderCents Int          @default(0)
  expiresAt     DateTime?
  orders        Order[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  rating    Int // 1–5
  text      String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId])
}
